# Normalize line endings to LF in the repo so the CI bundle-drift check
# (git diff --exit-code -- dist/) is stable across Windows/macOS/Linux.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary

# Collapsed in pull requests and excluded from the language bar. Dependabot
# opens these weekly and the churn is machine-written, not reviewable by eye.
package-lock.json linguist-generated=true

# Built bundle, committed and executed directly by the Action. Generated, so it
# is kept out of the language bar and folded shut in diffs.
dist/* linguist-generated=true
